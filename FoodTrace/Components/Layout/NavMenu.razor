@inject ISesionFoodTrace Sesion
<nav class="foodtrace-navigation" aria-label="Módulos administrativos">
<MudNavMenu Color="Color.Primary">
    <MudText Typo="Typo.overline" Class="px-4 mt-3">General</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
    <MudText Typo="Typo.overline" Class="px-4 mt-3">Operación</MudText>
    <MudNavLink Href="/produccion" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Factory">Producción</MudNavLink>
    <MudNavLink Href="/compras" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">Compras</MudNavLink>
    <MudText Typo="Typo.overline" Class="px-4 mt-3">Gestión</MudText>
    <MudNavLink Href="/catalogos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Catálogos</MudNavLink>
    @if (Sesion.TieneRol("admin"))
    {
        <MudText Typo="Typo.overline" Class="px-4 mt-3">Administración</MudText>
        <MudNavLink Href="/usuarios" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
    }
</MudNavMenu>
</nav>

