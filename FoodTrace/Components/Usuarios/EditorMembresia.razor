<MudStack Spacing="2">
    <MudText Typo="Typo.body2">Permisos de @Modelo.Correo</MudText>
    <EditForm Model="Modelo" id="@FormId" OnValidSubmit="() => Guardar.InvokeAsync()">
        <DataAnnotationsValidator />
        <ValidacionServidor CrearMapa="() => MapasValidacionServidor.Membresia(Modelo)" />
        <MudCheckBox T="bool" @bind-Value="Modelo.Habilitado" For="() => Modelo.Habilitado" Label="Acceso habilitado a esta empresa" Disabled="Ocupado" />
        <ValidationMessage For="() => Modelo.Habilitado" />
        <SelectorRoles @bind-Roles="Modelo.Roles" Ocupado="Ocupado" />
        <ValidationMessage For="() => Modelo.Roles" />
        <ValidationSummary />
        @if (!AccionesExternas)
        {
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="Ocupado">Revisar cambios de permisos</MudButton>
            <MudButton Disabled="Ocupado" OnClick="Cancelar">Cancelar edición</MudButton>
        }
    </EditForm>
</MudStack>
@code {
    [Parameter, EditorRequired] public FormularioMembresia Modelo { get; set; } = new();
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public EventCallback Guardar { get; set; }
    [Parameter] public EventCallback Cancelar { get; set; }
    [Parameter] public string FormId { get; set; } = "";
    [Parameter] public bool AccionesExternas { get; set; }
}
