@if (Elementos.Count == 0) { <EstadoVacio Mensaje="No hay productos registrados." /> }
else
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="my-3">
        <MudTextField T="string" @bind-Value="busqueda" @bind-Value:after="ReiniciarPagina"
                      Label="Buscar en registros cargados" HelperText="Producto o unidad base · búsqueda local"
                      Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        <MudSelect T="bool" @bind-Value="descendente" @bind-Value:after="ReiniciarPagina" Label="Ordenar productos">
            <MudSelectItem Value="false">Nombre A–Z</MudSelectItem>
            <MudSelectItem Value="true">Nombre Z–A</MudSelectItem>
        </MudSelect>
        <MudSelect T="int" @bind-Value="tamanoPagina" @bind-Value:after="ReiniciarPagina" Label="Filas por página">
            <MudSelectItem Value="10">10</MudSelectItem>
            <MudSelectItem Value="25">25</MudSelectItem>
            <MudSelectItem Value="50">50</MudSelectItem>
        </MudSelect>
    </MudStack>
    <MudTable Items="Filtrados" @bind-CurrentPage="pagina" RowsPerPage="tamanoPagina" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent><MudTh>Producto</MudTh><MudTh>Unidad base</MudTh></HeaderContent>
        <RowTemplate><MudTd DataLabel="Producto">@context.Nombre</MudTd><MudTd DataLabel="Unidad base">@context.UnidadBaseId</MudTd></RowTemplate>
        <NoRecordsContent><MudText>No hay coincidencias. Borre la búsqueda para ver los productos cargados.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager HideRowsPerPage="true" InfoFormat="{first_item}–{last_item} de {all_items}" /></PagerContent>
    </MudTable>
}
@code {
    [Parameter] public List<ProductoDto> Elementos { get; set; } = [];
    private string busqueda = "";
    private bool descendente;
    private int pagina;
    private int tamanoPagina = 10;
    private void ReiniciarPagina() => pagina = 0;
    protected override void OnParametersSet() => pagina = Math.Clamp(pagina, 0, Math.Max(0, (Coincidencias.Count() - 1) / tamanoPagina));
    private IEnumerable<ProductoDto> Filtrados => descendente
        ? Coincidencias.OrderByDescending(x => x.Nombre, StringComparer.CurrentCultureIgnoreCase)
        : Coincidencias.OrderBy(x => x.Nombre, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<ProductoDto> Coincidencias => Elementos.Where(x => $"{x.Nombre} {x.UnidadBaseId}".Contains(busqueda?.Trim() ?? "", StringComparison.CurrentCultureIgnoreCase));
}
