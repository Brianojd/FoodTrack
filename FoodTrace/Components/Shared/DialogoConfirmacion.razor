<MudDialog>
    <DialogContent><MudText>@Mensaje</MudText></DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialogo.Close(DialogResult.Ok(true))">Confirmar</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] public IMudDialogInstance Dialogo { get; set; } = null!;
    [Parameter] public string Mensaje { get; set; } = "";
}
