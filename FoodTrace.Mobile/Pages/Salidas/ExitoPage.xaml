<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodTrace.Mobile.Pages.Salidas.ExitoPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Background}">

    <VerticalStackLayout Padding="24" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="400">

        <Image Source="icon_check_large.png" HeightRequest="72" WidthRequest="72" HorizontalOptions="Center" Margin="0,0,0,16" />

        <Label Text="Salida Registrada"
               FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}"
               HorizontalOptions="Center" />

        <Label Text="El lote fue procesado exitosamente y se descontó del inventario actual."
               FontSize="14" TextColor="{DynamicResource TextSecondary}"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,24" />

        <!-- Cuadro resumen de la operación -->
        <Border Stroke="#E0E0E0" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="16">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12">
                <Label Grid.Row="0" Grid.Column="0" Text="Referencia:" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding ReferenciaSalida, FallbackValue='#TR-8829-X'}" FontSize="12" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" HorizontalOptions="End" />

                <Label Grid.Row="1" Grid.Column="0" Text="Descontado:" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CantidadDescontadaTexto, FallbackValue='5 kg'}" FontSize="12" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" HorizontalOptions="End" />
            </Grid>
        </Border>

        <Button Text="Volver al Inicio"
                BackgroundColor="{DynamicResource Primary}" TextColor="White"
                CornerRadius="8" HeightRequest="52" FontAttributes="Bold"
                Margin="0,32,0,0"
                Clicked="OnVolverInicioClicked" />

    </VerticalStackLayout>
</ContentPage>
