<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodTrace.Mobile.Pages.Salidas.ConsumoPage"
             Title="Volver"
             BackgroundColor="{DynamicResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,24" Spacing="16" HorizontalOptions="Center" MaximumWidthRequest="400">

            <!-- Icono Éxito -->
            <Image Source="icon_check_circle.png" HeightRequest="48" WidthRequest="48" HorizontalOptions="Center" />

            <Label Text="Lote Verificado Exitosamente"
                   FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Primary}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,16" />

            <!-- Tarjetas de Datos de Solo Lectura -->
            <Border Stroke="#E0E0E0" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="12,8">
                <VerticalStackLayout>
                    <Label Text="INSUMO / PRODUCTO" FontSize="10" TextColor="{DynamicResource TextSecondary}" FontAttributes="Bold" />
                    <Label Text="{Binding NombreProducto, FallbackValue='Pechuga de Pollo'}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E0E0E0" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="12,8">
                <VerticalStackLayout>
                    <Label Text="NÚMERO DE LOTE" FontSize="10" TextColor="{DynamicResource TextSecondary}" FontAttributes="Bold" />
                    <Label Text="{Binding CodigoLote, FallbackValue='LOTE-2024-X99'}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E0E0E0" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="12,8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="SALDO DISPONIBLE:" FontSize="12" TextColor="{DynamicResource TextSecondary}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="{Binding SaldoFormateado, FallbackValue='20 kg'}" FontSize="16" TextColor="{DynamicResource Primary}" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Acciones de Consumo -->
            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,16" />

            <Button x:Name="ConsumirTodoButton"
                    Text="Consumir Todo (Cerrar Caja)"
                    BackgroundColor="{DynamicResource Primary}" TextColor="White"
                    CornerRadius="8" HeightRequest="52" FontAttributes="Bold"
                    Clicked="OnConsumirTodoClicked" />

            <Label Text="O extraer una cantidad parcial:" FontSize="12" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" Margin="0,8,0,0" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <Border Stroke="{DynamicResource TextSecondary}" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Entry x:Name="ConsumoParcialEntry" Placeholder="Ej. 5" Keyboard="Numeric" />
                </Border>
                <Button x:Name="DescontarButton"
                        Grid.Column="1" Text="Descontar"
                        BackgroundColor="White" TextColor="{DynamicResource Primary}"
                        BorderColor="{DynamicResource Primary}" BorderWidth="1.5"
                        CornerRadius="8" HeightRequest="48" FontAttributes="Bold"
                        Clicked="OnDescontarParcialClicked" />
            </Grid>

            <Button x:Name="CancelarButton"
                    Text="Volver"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="0,8,0,0"
                    Clicked="OnVolverClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
