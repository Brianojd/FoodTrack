<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FoodTrace.Mobile.Controls"
             x:Class="FoodTrace.Mobile.Pages.LoginPage"
             Style="{DynamicResource PageStyle}"
             Title="Ingresar">
    <Grid RowDefinitions="*">
        <BoxView Grid.Row="0" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <BoxView.Background>
                <RadialGradientBrush Center="1,0" Radius="0.9">
                    <GradientStop Color="{DynamicResource HaloColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource TransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <Grid Padding="24,24,24,24" MinimumHeightRequest="560" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="0"
                                     MaximumWidthRequest="400"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     TranslationY="-20">
            <Label Text="FoodTrace Mobile" Style="{DynamicResource LoginTitleStyle}" />
            <Label Text="GESTIÓN LOGÍSTICA DE INVENTARIO"
                   Margin="0,8,0,0"
                   Style="{DynamicResource LoginSubtitleStyle}" />
            <VerticalStackLayout Margin="0,48,0,0" Spacing="0">
                <Label Text="Correo electrónico" Style="{DynamicResource FieldLabelStyle}" />
                <Border x:Name="EmailFieldBorder" Margin="0,8,0,0" Style="{DynamicResource FieldContainerStyle}">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="user_outline.svg" />
                        <controls:LoginEntry x:Name="EmailEntry"
                               Grid.Column="1"
                               Style="{DynamicResource EntryTextStyle}"
                               Placeholder="Ej. usuario@empresa.com"
                               Keyboard="Email"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               ReturnType="Next"
                               Focused="FieldFocused"
                               Unfocused="FieldUnfocused"
                               Completed="EmailCompleted" />
                    </Grid>
                </Border>
                <Label Text="Contraseña" Margin="0,24,0,0" Style="{DynamicResource FieldLabelStyle}" />
                <Border x:Name="PasswordFieldBorder" Margin="0,8,0,0" Style="{DynamicResource FieldContainerStyle}">
                    <Grid ColumnDefinitions="28,*,44" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="lock_outline.svg" />
                        <controls:LoginEntry x:Name="PasswordEntry"
                               Grid.Column="1"
                               Style="{DynamicResource EntryTextStyle}"
                               IsPassword="True"
                               ReturnType="Done"
                               Focused="FieldFocused"
                               Unfocused="FieldUnfocused"
                               Completed="PasswordCompleted" />
                        <ImageButton x:Name="PasswordVisibilityButton"
                                     Grid.Column="2"
                                     Source="eye_outline.svg"
                                     Clicked="TogglePasswordClicked"
                                     Style="{DynamicResource LoginIconButtonStyle}"
                                     AutomationProperties.Name="Mostrar u ocultar contraseña" />
                    </Grid>
                </Border>
                <Button x:Name="LoginButton"
                        Text="Iniciar Sesión"
                        Margin="0,24,0,0"
                        Clicked="LoginClicked"
                        Style="{DynamicResource LoginPrimaryButtonStyle}" />
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Margin="0,12,0,0"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Style="{DynamicResource LoginLoadingStyle}" />
            </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
